[Unit]
Description=EC2 autoscaler controller
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=autoscaler
Group=autoscaler
WorkingDirectory=/opt/autoscaler-controller
EnvironmentFile=/etc/autoscaler-controller.env
ExecStart=/opt/autoscaler-controller/controller
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/autoscaler-controller

[Install]
WantedBy=multi-user.target
